# 매일 새벽 백업 알람 (SERVER.md). /etc/systemd/system/에 복사하고 켠다: sudo systemctl enable --now play-backup.timer
[Unit]
Description=PlayLedger DB 백업 매일 04:30 (KST)

[Timer]
OnCalendar=*-*-* 04:30:00 Asia/Seoul
# 그 시각에 서버가 꺼져 있었으면, 켜진 뒤 바로 한 번 돈다
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
