# 서버의 /srv/playledger/.env로 복사해 쓴다 (권한 600). 저장소에는 빈칸만 둔다 (SERVER.md)
# 비밀번호는 영문 · 숫자만 나오게 만든다(openssl rand -hex 32) ─ DB 주소 안에 그대로 들어가서 기호가 있으면 주소가 깨진다
SITE_ADDRESS=play.sagming.com
POSTGRES_USER=playledger
POSTGRES_DB=playledger
POSTGRES_PASSWORD=
# 32자 이상. openssl rand -hex 32
JWT_SECRET_KEY=
# 게임 목록 미러링용. 값은 화면 · 채팅 · 로그에 내지 않는다
STEAM_API_KEY=
