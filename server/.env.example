# FastAPI 서버용 설정 ─ server/.env 예시 파일
# 비밀번호 root .env의 POSTGRES_PASSWORD와 반드시 같아야 한다
# DATABASE_URL 형식 → postgresql+asyncpg://사용자:비밀번호@localhost:5434/playledger
#   +asyncpg를 빼면 SQLAlchemy가 동기 드라이버(psycopg2)를 찾다가 ModuleNotFoundError로 서버가 안 뜬다
#   포트는 컨테이너 안쪽 5432가 아니라 바깥 5434 (docker-compose.yml ports)
# JWT_SECRET_KEY= → python -c "import secrets; print(secrets.token_urlsafe(32))"로 랜덤값 생성. 32자 미만이면 서버가 뜨지 않는다
# TEST_DATABASE_URL= → DATABASE_URL과 같되 DB명만 playledger_test
# DB는 Git으로 따라오지 않으므로 기기마다 CREATE DATABASE playledger_test 필요
# STEAM_API_KEY= → https://steamcommunity.com/dev/apikey 에서 발급. 게임 목록 미러링 스크립트만 쓴다
# ENABLE_DOCS= → false면 /docs · /redoc · /openapi.json을 끈다. 운영에서 끈다. 비워 두지 말고 줄을 지우면 기본값 true
#   비어 있어도 서버와 테스트는 돌아간다. 값은 화면 캡처 · 채팅에 노출하지 않는다
DATABASE_URL=
JWT_SECRET_KEY=

TEST_DATABASE_URL=

STEAM_API_KEY=
