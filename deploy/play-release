#!/usr/bin/env bash
# play-release ─ 서버 쪽 배포 (SERVER.md). /usr/local/bin/에 설치한다
# 쓰는 법: sudo play-release <40자리 커밋>   (CI가 그 커밋의 이미지를 GHCR에 올린 뒤에)
# 비유: 간판 바꿔 달기 ─ 새 간판을 먼저 받아 두고(pull), 장부 사본을 뜨고(backup), 장부 양식을 고치고(migrate),
#       간판을 단 뒤(up) 손님 응대가 되는지 본다. 안 되면 옛 간판을 다시 단다
# 받기와 백업이 실패하면 운영은 전혀 건드리지 않은 상태로 멈춘다

set -euo pipefail

ROOT=/srv/playledger
RAW=https://raw.githubusercontent.com/sagming40/PlayLedger

log() { echo "[release] $*"; }
die() {
	echo "[release] 실패: $*" >&2
	exit 1
}

compose_as() {
	local tag=$1 file=$2
	shift 2
	IMAGE_TAG=$tag docker compose --project-directory "$ROOT" -f "$file" --env-file "$ROOT/.env" "$@"
}

# 밖에서 들어오는 길 그대로 Caddy → API → DB까지 본다
healthy() {
	local site try
	site=$(grep -E '^SITE_ADDRESS=' "$ROOT/.env" | cut -d= -f2-)
	for try in $(seq 1 30); do
		if curl -fs -o /dev/null --max-time 3 "https://$site/api/health"; then
			log "헬스체크 통과 (${try}번째)"
			return 0
		fi
		sleep 2
	done
	return 1
}

[[ $EUID -eq 0 ]] || die "sudo로 실행해야 한다"
[[ $# -eq 1 ]] || die "사용법: play-release <커밋>"
COMMIT=$1
# 커밋 번호 모양만 받는다. 이미지 태그는 CI가 전체 커밋 번호로 만든다
[[ $COMMIT =~ ^[0-9a-f]{40}$ ]] || die "40자리 커밋 번호가 아니다: $COMMIT"
[[ -f $ROOT/.env ]] || die "$ROOT/.env가 없다"

# 두 PC가 동시에 배포하지 않게 잠근다
exec 9>/run/lock/playledger-deploy.lock
flock -n 9 || die "다른 배포가 진행 중이다"

PREV=""
if [[ -f $ROOT/image.env ]]; then
	PREV=$(cut -d= -f2 "$ROOT/image.env")
fi

# ── 1. 그 커밋의 Compose와 이미지 받기 ── 여기까지는 운영에 영향이 없다
log "받는 중: $COMMIT"
curl -fsS --max-time 20 -o "$ROOT/compose.new.yaml" "$RAW/$COMMIT/deploy/compose.prod.yaml" ||
	die "Compose 파일을 받지 못했다 (push했나?)"
compose_as "$COMMIT" "$ROOT/compose.new.yaml" pull web api ||
	die "이미지를 받지 못했다 (CI가 끝났나? 통과했나?)"

# ── 2. 배포 직전 백업 ── 첫 배포에는 DB가 비어 있어 건너뛴다
if [[ -n $PREV ]]; then
	log "배포 직전 백업"
	play-backup || die "백업 실패 ─ 배포를 멈춘다 (아직 아무것도 안 바꿨다)"
fi

# ── 3. 마이그레이션 ── 새 코드가 쓸 표를 먼저 만든다
compose_as "$COMMIT" "$ROOT/compose.new.yaml" up -d --wait db
log "마이그레이션"
compose_as "$COMMIT" "$ROOT/compose.new.yaml" run --rm --no-deps api alembic upgrade head ||
	die "마이그레이션 실패 ─ 앱은 아직 옛 버전이다. 반쯤 적용됐는지 alembic current로 본다"

# ── 4. 교체 · 확인 ──
log "교체"
if compose_as "$COMMIT" "$ROOT/compose.new.yaml" up -d --wait --wait-timeout 120 --remove-orphans && healthy; then
	[[ -f $ROOT/compose.yaml ]] && cp "$ROOT/compose.yaml" "$ROOT/compose.prev.yaml"
	mv "$ROOT/compose.new.yaml" "$ROOT/compose.yaml"
	echo "IMAGE_TAG=$COMMIT" >"$ROOT/image.env"
	# 일주일 넘게 안 쓴 이미지만 지운다 ─ 25GB 디스크가 옛 이미지로 차지 않게
	docker image prune -af --filter "until=168h" >/dev/null || true
	log "완료: $COMMIT"
	exit 0
fi

# ── 5. 되돌리기 ── 표는 되돌리지 않는다(되돌리는 쪽이 데이터를 잃을 수 있다). 필요하면 백업으로 복구한다 (SERVER.md)
if [[ -z $PREV ]]; then
	die "새 버전이 살아나지 않았다. 첫 배포라 되돌릴 곳이 없다 ─ sudo docker logs로 본다"
fi
log "새 버전이 살아나지 않아 $PREV 로 되돌린다"
compose_as "$PREV" "$ROOT/compose.yaml" up -d --wait --wait-timeout 120 --remove-orphans ||
	die "되돌리기도 실패했다. 지금 서비스가 멈췄을 수 있다"
healthy || die "되돌렸지만 헬스체크가 안 된다"
die "$COMMIT 배포 실패, $PREV 로 되돌림. 마이그레이션은 적용된 채다"
