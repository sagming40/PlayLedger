# ============================================================
# PlayLedger .gitignore
# 새집(Git 저장소)으로 안 가져갈 물건 목록
# ============================================================

# ── 비밀값 ─────────────────────────────────────────────
# 금고 열쇠. 어느 폴더에 있든(server/, web/, 루트) 전부 제외
.env
.env.*
# 단, 열쇠 "모양 설명서"는 가져간다 (키 이름만 있고 값은 빈 파일)
# 위의 .env.* 가 .env.example 까지 잡아버리니까 !로 예외 처리
!.env.example

# ── Python (server/) ───────────────────────────────────
# 가상환경 = 이 PC 전용 공구함. 다른 PC는 requirements.txt 보고 새로 만든다
venv/
.venv/
# 파이썬이 속도 올리려고 만든 번역본 캐시. 원본(.py)만 있으면 언제든 다시 생김
__pycache__/
*.py[cod]
# pytest가 남기는 메모장
.pytest_cache/
.coverage
htmlcov/

# ── Node / Vite (web/) ─────────────────────────────────
# npm이 받아온 부품 창고. package.json만 있으면 npm install로 복원됨
node_modules/
# 빌드 결과물 = 완성된 요리. 레시피(src/)만 저장하면 된다
dist/
# Vite 관례상 .local 이 붙은 파일은 "이 PC 전용 설정"
*.local

# ── 로그 ───────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── OS · 에디터 ────────────────────────────────────────
# Windows가 폴더마다 몰래 만드는 썸네일 · 폴더 설정 파일
Thumbs.db
desktop.ini
# VS Code 개인 설정(테마·창 배치 등)은 제외하되, 확장 추천 목록은 공유한다
**/.vscode/*
!**/.vscode/extensions.json
