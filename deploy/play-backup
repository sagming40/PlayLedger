#!/usr/bin/env bash
# play-backup ─ 운영 DB를 덤프해서 age로 잠가 /var/backups/playledger/에 둔다 (SERVER.md). /usr/local/bin/에 설치한다
# 매일 play-backup.timer가, 배포 직전에는 play-release가 부른다
# 비유: 장부 사본을 떠서 금고에 넣기 ─ 서버에는 자물쇠(공개키)만 있고, 여는 열쇠(개인키)는 내 PC에만 있다
#       서버가 털려도 사본은 못 연다

set -euo pipefail

RECIPIENTS=/etc/playledger/backup.pub
DEST=/var/backups/playledger
KEEP=14
# 서버 밖 사본 (SERVER 3.9절). 이 파일이 없으면 서버에만 둔다
R2_ENV=/etc/playledger/r2.env
R2_DAYS=14   # 개인정보 안내의 "14일"과 같아야 한다 (web/src/views/PrivacyView.vue)

die() {
	echo "[backup] 실패: $*" >&2
	exit 1
}

[[ $EUID -eq 0 ]] || die "sudo로 실행해야 한다"
[[ -s $RECIPIENTS ]] || die "공개키가 없다: $RECIPIENTS"

install -d -m 755 "$DEST"
# 이름에 UTC 시각을 넣는다 → 이름순 = 시간순
NAME=playledger-$(date -u +%Y%m%dT%H%M%SZ).dump.age
[[ ! -e $DEST/$NAME ]] || die "같은 이름이 이미 있다: $NAME (잠시 뒤 다시)"
TMP=$DEST/.$NAME.tmp
trap 'rm -f "$TMP"' EXIT

# steam_apps(공개 게임 목록 20만 행)는 빼고 구조만 남긴다 ─ 미러링으로 언제든 다시 만들 수 있고, 백업이 작아진다
# -T: 터미널 없이(타이머에서도 돈다). -Fc: pg_restore로 되살리는 압축 형식
# pipefail 덕분에 pg_dump가 실패하면 전체가 실패한다. 크기로는 못 본다 ─ 빈 입력도 잠그면 200바이트쯤 된다
# 작은따옴표가 맞다 ─ $POSTGRES_USER는 서버가 아니라 컨테이너 안에서 풀린다
# shellcheck disable=SC2016
play-compose exec -T db sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Fc --exclude-table-data=steam_apps' |
	age -R "$RECIPIENTS" -o "$TMP" ||
	die "pg_dump 또는 age가 실패했다"

# 일반 계정이 scp로 받아 갈 수 있게 연다. 내용은 잠겨 있다
chmod 644 "$TMP"
mv "$TMP" "$DEST/$NAME"
echo "[backup] 만듦: $DEST/$NAME ($(stat -c %s "$DEST/$NAME") 바이트)"

# 최근 KEEP개만 남긴다. 계정을 지운 사람의 기록도 이 기간이 지나면 사라진다 (개인정보 안내)
find "$DEST" -maxdepth 1 -name 'playledger-*.dump.age' -printf '%f\n' |
	sort -r | tail -n +$((KEEP + 1)) |
	while read -r old; do
		echo "[backup] 정리: $old"
		rm -f -- "$DEST/$old"
	done

# ── 서버 밖 사본 (Cloudflare R2) ── 서버가 통째로 사라져도 남게 한다
# 잠긴 파일 그대로 올린다 ─ Cloudflare도 열 수 없다. 열쇠는 PC에만 있다
# 실패해도 서버 사본은 이미 있다 ─ 종료 코드 3으로 구분한다. 타이머는 실패로 남고, play-release는 배포를 계속한다
[[ -f $R2_ENV ]] || exit 0
# r2.env: RCLONE_CONFIG_R2_* (rclone이 환경변수로 원격을 만든다)와 R2_BUCKET. 권한 600, 값은 화면에 내지 않는다
# --config "" ─ 설정 파일을 쓰지 않는다 (없다는 안내 줄이 매일 찍히지 않게)
# --contimeout · --low-level-retries ─ R2에 닿지 않을 때 기본값이면 2분 넘게 붙잡혀 배포까지 늦어진다
set -a
# shellcheck source=/dev/null
. "$R2_ENV"
set +a
[[ -n ${R2_BUCKET:-} ]] || { echo "[backup] R2 실패: $R2_ENV에 R2_BUCKET이 없다" >&2; exit 3; }

if ! rclone --config "" --contimeout 10s --low-level-retries 3 copyto "$DEST/$NAME" "r2:$R2_BUCKET/$NAME"; then
	echo "[backup] R2 실패: 올리지 못했다 (서버 사본은 있다: $DEST/$NAME)" >&2
	exit 3
fi
echo "[backup] R2에 올림: $NAME"

# 서버와 달리 개수가 아니라 날짜로 지운다 ─ 배포 직전 백업이 끼어도 "14일"이 그대로다
# 올린 시각이 아니라 원본 파일 시각으로 센다 (rclone이 메타데이터에 담는다)
if ! rclone --config "" --contimeout 10s --low-level-retries 3 delete "r2:$R2_BUCKET" --include 'playledger-*.dump.age' --min-age "${R2_DAYS}d"; then
	echo "[backup] R2 실패: 오래된 사본을 지우지 못했다" >&2
	exit 3
fi
