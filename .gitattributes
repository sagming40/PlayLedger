# ============================================================
# PlayLedger .gitattributes
# 이 저장소의 "건물 관리규약". PC별 설정(core.autocrlf)보다 우선한다
# ============================================================

# 모든 파일(*)에 대해:
#   text=auto → 텍스트인지 이미지 같은 바이너리인지 Git이 알아서 판별
#               (바이너리는 절대 안 건드림. 사진 파일 줄바꿈을 바꾸면 깨지니까)
#   eol=lf    → 텍스트 파일은 창고에도, 책상에도 항상 LF로 꺼내준다
* text=auto eol=lf
