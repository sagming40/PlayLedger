# 서버의 /etc/playledger/r2.env로 복사해 쓴다 (권한 600, SERVER 3.9절). 저장소에는 빈칸만 둔다
# play-backup이 읽는다. rclone은 RCLONE_CONFIG_<이름>_* 환경변수로 원격 "r2"를 만든다 ─ 설정 파일이 따로 없다
# 값은 화면 캡처 · 채팅 · 로그에 내지 않는다 (2026-11-04 .env 캡처 사고, SERVER 5절)
R2_BUCKET=playledger-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
# https://<계정 ID>.r2.cloudflarestorage.com ─ R2 화면의 "S3 API" 주소에서 버킷 이름을 뺀 것
RCLONE_CONFIG_R2_ENDPOINT=
# 이 버킷 하나에만 "객체 읽기 · 쓰기" 권한을 준 API 토큰의 값
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# 버킷 하나에만 권한이 있는 토큰은 버킷을 만들거나 확인할 수 없다 ─ 있는 버킷에 바로 올린다
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
